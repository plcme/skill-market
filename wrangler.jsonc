{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brewdex",
  "account_id": "b1eb3d7d03b40f01f9e9c3ef18cf00d5",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "brewdex" }],
  "ratelimits": [{ "name": "INVITE_RATE_LIMITER", "namespace_id": "20261023", "simple": { "limit": 10, "period": 60 } }],
  "routes": [{ "pattern": "brewdex.app", "custom_domain": true }]
}
